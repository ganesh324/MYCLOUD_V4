# Copy to app/data/mycloud.env and customize for this machine.
# app/data is ignored by git so personal values and secrets stay local.
MYCLOUD_APP_DIR=/path/to/mycloud
MYCLOUD_PUBLIC_BASE_URL=http://localhost:3000
MYCLOUD_HEALTH_URL=http://localhost:3000/api/health
MYCLOUD_STORAGE_ROOT=/path/to/storage
MYCLOUD_STORAGE_LABEL=Storage
MYCLOUD_STORAGE_DEVICE=/dev/sdX1
MYCLOUD_SECRET_KEY=replace-with-a-long-random-secret
MYCLOUD_CORS_ORIGINS=*
MYCLOUD_DEFAULT_FAVORITE_PATH=/path/to/storage
MYCLOUD_DEFAULT_FAVORITE_LABEL=Storage
MYCLOUD_WATCHDOG_LOG=/path/to/mycloud/app/data/watchdog.log
MYCLOUD_DRIVE_REPORT=/path/to/mycloud/app/data/drive_report.txt
MYCLOUD_SEED_USERS='[{"username":"admin","password":"change-me","role":"admin","display_name":"Admin"}]'
MYCLOUD_LOGIN_PROFILES='[{"id":"admin","display_name":"Admin","initials":"AD","username":"admin"}]'
